# Configuracion del proyecto.
# Copia este archivo a .env y ajusta los valores. Las rutas relativas se cuentan desde
# la carpeta del proyecto. Las variables reales del sistema tienen prioridad sobre este archivo.

# java_cacerts_installer.py
# Contrasena por defecto del cacerts de Java (changeit es la que trae Java)
CACERTS_PASSWORD=changeit
# Descarga de certificados: segundos de espera por intento, numero de intentos y espera inicial entre reintentos
CERT_FETCH_TIMEOUT=20
CERT_FETCH_ATTEMPTS=3
CERT_FETCH_RETRY_DELAY=2
# Descargas en paralelo (las instalaciones en cacerts siguen en orden)
CERT_FETCH_WORKERS=4
# Lista de dominios cuyos certificados se instalan
DOMAINS_FILE=config/domains.json

# windows_env_setup.py
JAVA_CONFIG_FILE=config/java.json
MAVEN_CONFIG_FILE=config/maven.json

# rsa_keygen.py, rsa_crypt.py, text_qr.py
KEYS_DIR=keys
RSA_KEY_BITS=2048
PUBLIC_KEY_FILE=keys/rsa_public.pem
PRIVATE_KEY_FILE=keys/rsa_private.pem

# qr_generator.py, text_qr.py
# Correccion de errores: L, M, Q o H
QR_ERROR_CORRECTION=M
# Pixeles por modulo en las imagenes PNG
QR_BOX_SIZE=10
# Caracteres por parte cuando un texto se divide en varios QR
QR_CHUNK_SIZE=1200
